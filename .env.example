# ==============================================================================
# AGRIFY — AGRICULTURAL INTELLIGENCE NETWORK (INDIA)
# Server-Side Environment Variables & External Provider Credentials
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Never commit your real .env file with secrets into version control.
# - Fast2SMS and MSG91 API keys are kept strictly server-side and never exposed to the frontend.

# ------------------------------------------------------------------------------
# 1. SMS GATEWAY CONFIGURATION (Fast2SMS or MSG91)
# ------------------------------------------------------------------------------
# Mode: "simulation" (default, free offline simulator) or "production" (real telco SMS delivery)
SMS_MODE=simulation

# Provider: "fast2sms" or "msg91"
SMS_PROVIDER=fast2sms

# --- FAST2SMS CONFIGURATION ---
# Sign up at: https://www.fast2sms.com/
# Retrieve your Authorization Key under "Dev API"
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Route: "q" for Quick Transactional SMS (ideal for development & instant tests without DLT approval)
#        "dlt" for Enterprise DLT-approved templates (requires registered DLT Header & Entity ID)
FAST2SMS_ROUTE=q

# Fast2SMS Sender ID (Default 6-character sender ID registered on DLT, e.g. FSTSMS)
FAST2SMS_SENDER_ID=FSTSMS

# Fast2SMS DLT Template ID (Required only if FAST2SMS_ROUTE=dlt)
FAST2SMS_DLT_TE_ID=

# --- MSG91 CONFIGURATION (ALTERNATIVE PROVIDER) ---
# Sign up at: https://msg91.com/
# Retrieve your Auth Key under Dashboard -> API -> Authkey
MSG91_AUTH_KEY=your_msg91_authkey_here

# MSG91 Sender ID (6-character registered sender name, e.g. AGRIFY)
MSG91_SENDER_ID=AGRIFY

# MSG91 DLT Flow / Template ID (Registered on Vilpower / Jio DLT portal)
MSG91_DLT_TE_ID=12071618290001

# ------------------------------------------------------------------------------
# 2. USSD TELECOM CALLBACK WEBHOOK CONFIGURATION
# ------------------------------------------------------------------------------
# Secret verification token for telecom USSD gateways (BSNL, Airtel, Jio, Route Mobile, Tanla, Gupshup)
# Telecom Gateway URL: https://your-domain.gov.in/api/ussd/callback
USSD_API_KEY=your_telecom_ussd_secret_token

# Default USSD service code assigned by telco operator
USSD_SERVICE_CODE=*999#

# ------------------------------------------------------------------------------
# 3. AI ADVISORY & GEMINI API KEY (OPTIONAL)
# ------------------------------------------------------------------------------
# Used for natural-language agronomic explanations and district crop advisory synthesis
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSION SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# JWT Session Secret for signing tokens (minimum 32 random characters in production)
AUTH_JWT_SECRET=agrify_super_secret_session_jwt_key_2026

# OTP Expiry duration in seconds (default: 300 = 5 minutes)
AUTH_OTP_EXPIRY_SECONDS=300

# Max incorrect OTP attempts before temporary lockout (default: 5)
AUTH_MAX_OTP_ATTEMPTS=5

